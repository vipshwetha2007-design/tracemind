# Copy this file to .env and fill in your own values.
# Never commit a real .env file — it's already in .gitignore.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SQLite for local development. Prisma resolves this path relative to
# prisma/schema.prisma, so this creates prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Optional — defaults to gemini-2.5-flash if not set.
# GEMINI_MODEL=gemini-2.5-flash
